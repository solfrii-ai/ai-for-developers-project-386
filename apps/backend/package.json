{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "api:generate": "tsp compile api/main.tsp --config tspconfig.yaml --output-dir generated",
    "drizzle:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm api:generate && tsc --noEmit && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-openapi-validator": "^5.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typespec/compiler": "^1.18.0",
    "@typespec/http": "^1.18.0",
    "@typespec/openapi3": "^1.18.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
