{
  "openapi": "3.0.0",
  "info": {
    "title": "Calendar Calls API",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {
    "/api/bookings": {
      "post": {
        "operationId": "BookingOperations_create",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "The server could not understand the request due to invalid syntax.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state of the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConflictResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBooking"
              }
            }
          }
        }
      }
    },
    "/api/meeting-types": {
      "get": {
        "operationId": "MeetingTypeOperations_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MeetingType"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "MeetingTypeOperations_create",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingType"
                }
              }
            }
          },
          "400": {
            "description": "The server could not understand the request due to invalid syntax.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMeetingType"
              }
            }
          }
        }
      }
    },
    "/api/meeting-types/{id}": {
      "get": {
        "operationId": "MeetingTypeOperations_read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingType"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meeting-types/{id}/availability": {
      "get": {
        "operationId": "MeetingTypeOperations_availability",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Availability"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Availability": {
        "type": "object",
        "required": [
          "days",
          "slots"
        ],
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityDay"
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilitySlot"
            }
          }
        }
      },
      "AvailabilityDay": {
        "type": "object",
        "required": [
          "date",
          "freeCount"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "freeCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AvailabilitySlot": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Booking": {
        "type": "object",
        "required": [
          "meetingTypeId",
          "meetingTypeName",
          "start",
          "end",
          "guestName",
          "guestEmail",
          "createdAt"
        ],
        "properties": {
          "meetingTypeId": {
            "type": "string"
          },
          "meetingTypeName": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string"
          },
          "guestEmail": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConflictResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "CreateBooking": {
        "type": "object",
        "required": [
          "meetingTypeId",
          "start",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "meetingTypeId": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "guestEmail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254
          }
        }
      },
      "CreateMeetingType": {
        "type": "object",
        "required": [
          "name",
          "description",
          "duration"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "duration": {
            "$ref": "#/components/schemas/MeetingDuration"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MeetingDuration": {
        "type": "number",
        "enum": [
          15,
          30,
          45,
          60,
          75,
          90,
          105,
          120
        ]
      },
      "MeetingType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]{3}-[a-z0-9]{5}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "duration": {
            "$ref": "#/components/schemas/MeetingDuration"
          }
        }
      },
      "NotFoundResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      }
    }
  }
}
